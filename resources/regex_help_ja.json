[
  {
    "category": "位置",
    "label": "行の先頭",
    "pattern": "^",
    "description": "行の一番はじめの位置に一致します。文字そのものではなく、位置を探します。",
    "example_text": "TODO 用紙を買う",
    "usage_example": "^TODO",
    "matches": "TODO の前の位置",
    "replace_with": "DONE ",
    "replacement_result": "DONE TODO 用紙を買う"
  },
  {
    "category": "位置",
    "label": "行の末尾",
    "pattern": "$",
    "description": "行の一番最後の位置に一致します。末尾へ文字を足したい時に使えます。",
    "example_text": "report",
    "usage_example": "report$",
    "matches": "report の後ろの位置",
    "replace_with": ".txt",
    "replacement_result": "report.txt"
  },
  {
    "category": "文字",
    "label": "数字",
    "pattern": "\\d",
    "description": "数字1文字に一致します。",
    "example_text": "会議室 A12",
    "usage_example": "\\d",
    "matches": "1, 2",
    "replace_with": "#",
    "replacement_result": "会議室 A##"
  },
  {
    "category": "文字",
    "label": "数字以外",
    "pattern": "\\D",
    "description": "数字ではない1文字に一致します。",
    "example_text": "A12",
    "usage_example": "\\D",
    "matches": "A",
    "replace_with": "",
    "replacement_result": "12"
  },
  {
    "category": "文字",
    "label": "単語に使う文字",
    "pattern": "\\w",
    "description": "英数字またはアンダースコア1文字に一致します。",
    "example_text": "user_id!",
    "usage_example": "\\w+",
    "matches": "u, s, e, r, _, i, d",
    "replace_with": "",
    "replacement_result": "!"
  },
  {
    "category": "文字",
    "label": "単語に使わない文字",
    "pattern": "\\W",
    "description": "英数字でもアンダースコアでもない1文字に一致します。",
    "example_text": "user_id!",
    "usage_example": "\\W",
    "matches": "!",
    "replace_with": "",
    "replacement_result": "user_id"
  },
  {
    "category": "空白",
    "label": "空白文字",
    "pattern": "\\s",
    "description": "半角スペース、タブ、改行などの空白1文字に一致します。",
    "example_text": "A B",
    "usage_example": "\\s",
    "matches": "A と B の間のスペース",
    "replace_with": "_",
    "replacement_result": "A_B"
  },
  {
    "category": "空白",
    "label": "空白以外",
    "pattern": "\\S",
    "description": "空白ではない1文字に一致します。",
    "example_text": "A B",
    "usage_example": "\\S",
    "matches": "A, B",
    "replace_with": "#",
    "replacement_result": "# #"
  },
  {
    "category": "文字",
    "label": "任意の1文字",
    "pattern": ".",
    "description": "改行以外の任意の1文字に一致します。",
    "example_text": "abc",
    "usage_example": "a.c",
    "matches": "a, b, c",
    "replace_with": "*",
    "replacement_result": "***"
  },
  {
    "category": "繰り返し",
    "label": "0回以上",
    "pattern": "*",
    "description": "直前の文字やグループを0回以上繰り返します。",
    "example_text": "abbb ac",
    "usage_example": "ab*",
    "matches": "abbb, a",
    "replace_with": "",
    "replacement_result": " c"
  },
  {
    "category": "繰り返し",
    "label": "1回以上",
    "pattern": "+",
    "description": "直前の文字やグループを1回以上繰り返します。",
    "example_text": "abbb ac",
    "usage_example": "ab+",
    "matches": "abbb",
    "replace_with": "",
    "replacement_result": " ac"
  },
  {
    "category": "繰り返し",
    "label": "あってもなくても良い",
    "pattern": "?",
    "description": "直前の文字やグループが0回または1回ある場合に一致します。",
    "example_text": "color colour",
    "usage_example": "colou?r",
    "matches": "colou?r で color, colour",
    "replace_with": "",
    "replacement_result": ""
  },
  {
    "category": "繰り返し",
    "label": "指定回数",
    "pattern": "{3}",
    "description": "直前の文字やグループを指定した回数だけ繰り返します。",
    "example_text": "ID: 1234",
    "usage_example": "\\d{3}",
    "matches": "\\d{3} で 123",
    "replace_with": "###",
    "replacement_result": "ID: ###4"
  },
  {
    "category": "繰り返し",
    "label": "回数の範囲",
    "pattern": "{2,5}",
    "description": "直前の文字やグループを指定した回数の範囲で繰り返します。",
    "example_text": "ID: 12 123456",
    "usage_example": "\\d{2,5}",
    "matches": "\\d{2,5} で 12, 12345",
    "replace_with": "NUM",
    "replacement_result": "ID: NUM NUM6"
  },
  {
    "category": "グループ",
    "label": "取り出して使う",
    "pattern": "()",
    "description": "一致した一部をグループとして取り出し、置換文字で再利用できます。",
    "example_text": "2026-09-10",
    "usage_example": "(\\d+)",
    "matches": "(\\d{4})-(\\d{2})-(\\d{2}) で年月日を分ける",
    "replace_with": "\\2/\\3/\\1",
    "replacement_result": "09/10/2026"
  },
  {
    "category": "グループ",
    "label": "どちらか",
    "pattern": "|",
    "description": "左側または右側のどちらかに一致します。",
    "example_text": "cat dog bird",
    "usage_example": "cat|dog",
    "matches": "cat|dog で cat, dog",
    "replace_with": "pet",
    "replacement_result": "pet pet bird"
  },
  {
    "category": "集合",
    "label": "文字の候補",
    "pattern": "[]",
    "description": "角括弧の中に書いた文字のどれか1文字に一致します。",
    "example_text": "gray grey",
    "usage_example": "[abc]",
    "matches": "gr[ae]y で gray, grey",
    "replace_with": "color",
    "replacement_result": "color color"
  },
  {
    "category": "集合",
    "label": "候補以外の文字",
    "pattern": "[^]",
    "description": "角括弧の中に書いた文字以外の1文字に一致します。",
    "example_text": "abc123",
    "usage_example": "[^abc]",
    "matches": "[^0-9] で a, b, c",
    "replace_with": "",
    "replacement_result": "123"
  },
  {
    "category": "境界",
    "label": "単語の境目",
    "pattern": "\\b",
    "description": "単語の端に一致します。cat と catalog を区別したい時に便利です。",
    "example_text": "cat catalog cat",
    "usage_example": "\\bcat\\b",
    "matches": "\\bcat\\b で先頭と末尾の cat",
    "replace_with": "dog",
    "replacement_result": "dog catalog dog"
  },
  {
    "category": "置換",
    "label": "1番目のグループを使う",
    "pattern": "\\1",
    "description": "置換文字の中で、1番目の括弧に一致した内容を使います。",
    "example_text": "Smith, John",
    "usage_example": "(\\w+) \\1",
    "matches": "(\\w+), (\\w+) で Smith と John",
    "replace_with": "\\2 \\1",
    "replacement_result": "John Smith"
  },
  {
    "category": "置換",
    "label": "2番目のグループを使う",
    "pattern": "\\2",
    "description": "置換文字の中で、2番目の括弧に一致した内容を使います。",
    "example_text": "Smith, John",
    "usage_example": "(\\w+) (\\w+)",
    "matches": "(\\w+), (\\w+) で Smith と John",
    "replace_with": "\\2 \\1",
    "replacement_result": "John Smith"
  },
  {
    "category": "実用例",
    "label": "空行を詰める",
    "pattern": "\\n{3,}",
    "description": "改行が3つ以上続く場所を探して、空きすぎた行間を整えます。",
    "example_text": "1行目\\n\\n\\n2行目",
    "usage_example": "\\n{3,}",
    "matches": "3つ続いた改行",
    "replace_with": "\\n\\n",
    "replacement_result": "1行目\\n\\n2行目"
  },
  {
    "category": "実用例",
    "label": "行末の空白を消す",
    "pattern": "[ \\t]+$",
    "description": "各行の最後にある余分なスペースやタブを探します。",
    "example_text": "メモ   ",
    "usage_example": "[ \\t]+$",
    "matches": "メモ の後ろのスペース",
    "replace_with": "",
    "replacement_result": "メモ"
  },
  {
    "category": "実用例",
    "label": "日付の順番を入れ替える",
    "pattern": "(\\d{4})-(\\d{2})-(\\d{2})",
    "description": "2026-09-10 のような日付を、年・月・日に分けて入れ替えます。",
    "example_text": "2026-09-10",
    "usage_example": "(\\d{4})-(\\d{2})-(\\d{2})",
    "matches": "2026-09-10",
    "replace_with": "\\2/\\3/\\1",
    "replacement_result": "09/10/2026"
  },
  {
    "category": "実用例",
    "label": "番号付きリストを箇条書きへ",
    "pattern": "^\\d+\\.\\s+",
    "description": "行頭の 1. や 23. のような番号を探します。",
    "example_text": "1. メール確認",
    "usage_example": "^\\d+\\.\\s+",
    "matches": "1. ",
    "replace_with": "- ",
    "replacement_result": "- メール確認"
  },
  {
    "category": "実用例",
    "label": "特定の語を含む行を探す",
    "pattern": "^.*urgent.*$",
    "description": "指定した語を含む行全体を探します。urgent の部分を探したい語に変えます。",
    "example_text": "通常\\nurgent task\\n完了",
    "usage_example": "^.*urgent.*$",
    "matches": "urgent task",
    "replace_with": "",
    "replacement_result": ""
  },
  {
    "category": "実用例",
    "label": "空行を削除",
    "pattern": "^[ \\t]*\\n",
    "description": "スペースやタブだけの行を探して、その行ごと削除します。",
    "example_text": "1行目\\n\\n2行目",
    "usage_example": "^[ \\t]*\\n",
    "matches": "間にある空行",
    "replace_with": "",
    "replacement_result": "1行目\\n2行目"
  },
  {
    "category": "実用例",
    "label": "タブを半角スペース4個に変換",
    "pattern": "\\t",
    "description": "タブ文字を探して、インデントの見え方を揃えます。",
    "example_text": "\\t字下げ",
    "usage_example": "\\t",
    "matches": "字下げ の前にあるタブ",
    "replace_with": "    ",
    "replacement_result": "    字下げ"
  },
  {
    "category": "複雑な組み合わせサンプル",
    "label": "同じ単語が続く場所",
    "pattern": "\\b(\\w+)\\s+\\1\\b",
    "description": "\\b で単語の境目を決め、(\\w+) で単語を取り出し、\\s+ で間の空白を許し、\\1 で同じ単語がもう一度出る場所を探します。",
    "example_text": "this is is a test",
    "usage_example": "\\b(\\w+)\\s+\\1\\b",
    "matches": "is is",
    "replace_with": "\\1",
    "replacement_result": "this is a test"
  },
  {
    "category": "複雑な組み合わせサンプル",
    "label": "引用符の中だけを取り出す",
    "pattern": "\"([^\"\\n]*)\"",
    "description": "\" で引用符を指定し、[^\"\\n]* で引用符と改行以外をまとめて取り出します。括弧の中身は置換で \\1 として使えます。",
    "example_text": "名前=\"佐藤\"",
    "usage_example": "\"([^\"\\n]*)\"",
    "matches": "\"佐藤\"",
    "replace_with": "\\1",
    "replacement_result": "名前=佐藤"
  },
  {
    "category": "複雑な組み合わせサンプル",
    "label": "開始タグと同じ終了タグ",
    "pattern": "<([a-z][a-z0-9]*)\\b[^>]*>(.*?)</\\1>",
    "description": "([a-z][a-z0-9]*) でタグ名を取り出し、</\\1> で同じタグ名の終了タグだけを探します。.*? は最短で本文部分を拾います。",
    "example_text": "<span>重要</span>",
    "usage_example": "<([a-z][a-z0-9]*)\\b[^>]*>(.*?)</\\1>",
    "matches": "<span>重要</span>",
    "replace_with": "\\2",
    "replacement_result": "重要"
  },
  {
    "category": "複雑な組み合わせサンプル",
    "label": "指定語を両方含む行",
    "pattern": "^.*受付.*完了.*$",
    "description": "^ と $ で1行全体を対象にし、.* で間の文字を許します。受付 の後ろに 完了 が出る行を探します。",
    "example_text": "受付のみ\\n受付メール送信完了\\n完了待ち",
    "usage_example": "^.*受付.*完了.*$",
    "matches": "受付メール送信完了",
    "replace_with": "",
    "replacement_result": ""
  },
  {
    "category": "事務・計算・住所",
    "label": "郵便番号",
    "pattern": "\\d{3}-\\d{4}",
    "description": "\\d{3} で3桁、- でハイフン、\\d{4} で4桁を指定します。",
    "example_text": "〒160-0022 東京都新宿区",
    "usage_example": "\\d{3}-\\d{4}",
    "matches": "160-0022",
    "replace_with": "郵便番号: \\g<0>",
    "replacement_result": "〒郵便番号: 160-0022 東京都新宿区"
  },
  {
    "category": "事務・計算・住所",
    "label": "電話番号",
    "pattern": "0\\d{1,4}-\\d{1,4}-\\d{3,4}",
    "description": "先頭の 0、地域や携帯の桁数違い、ハイフン区切りをまとめて探す簡易パターンです。",
    "example_text": "連絡先 03-1234-5678",
    "usage_example": "0\\d{1,4}-\\d{1,4}-\\d{3,4}",
    "matches": "03-1234-5678",
    "replace_with": "[電話]",
    "replacement_result": "連絡先 [電話]"
  },
  {
    "category": "事務・計算・住所",
    "label": "カンマ付き金額",
    "pattern": "\\d{1,3}(?:,\\d{3})+",
    "description": "\\d{1,3} で先頭1から3桁、(?:,\\d{3})+ でカンマと3桁の組を1回以上指定します。",
    "example_text": "売上 1,234,567 円",
    "usage_example": "\\d{1,3}(?:,\\d{3})+",
    "matches": "1,234,567",
    "replace_with": "",
    "replacement_result": ""
  },
  {
    "category": "事務・計算・住所",
    "label": "整数または小数",
    "pattern": "[+-]?\\d+(?:\\.\\d+)?",
    "description": "[+-]? で符号を任意にし、\\d+ で整数部分、(?:\\.\\d+)? で小数部分を任意にします。",
    "example_text": "差分 -12.5 点",
    "usage_example": "[+-]?\\d+(?:\\.\\d+)?",
    "matches": "-12.5",
    "replace_with": "",
    "replacement_result": ""
  },
  {
    "category": "事務・計算・住所",
    "label": "都道府県から始まる住所",
    "pattern": "(東京都|北海道|(?:京都|大阪)府|.{2,3}県).+?[市区町村].+",
    "description": "都道府県名を先頭で拾い、その後に市・区・町・村のどれかが出る住所らしい行を探す簡易パターンです。",
    "example_text": "東京都新宿区西新宿1-1-1",
    "usage_example": "(東京都|北海道|(?:京都|大阪)府|.{2,3}県).+?[市区町村].+",
    "matches": "東京都新宿区西新宿1-1-1",
    "replace_with": "",
    "replacement_result": ""
  },
  {
    "category": "事務・計算・住所",
    "label": "管理番号",
    "pattern": "[A-Z]{2,}-\\d{4,}",
    "description": "[A-Z]{2,} で英大文字2文字以上、-、\\d{4,} で4桁以上の番号を探します。請求書番号や管理番号の整理に使えます。",
    "example_text": "INV-20260925",
    "usage_example": "[A-Z]{2,}-\\d{4,}",
    "matches": "INV-20260925",
    "replace_with": "",
    "replacement_result": ""
  },
  {
    "category": "置換サンプル",
    "label": "スラッシュ日付をハイフン日付へ",
    "pattern": "(\\d{4})/(\\d{1,2})/(\\d{1,2})",
    "description": "年・月・日を括弧で分け、置換文字で \\1-\\2-\\3 の順に並べ直します。",
    "example_text": "2026/9/25",
    "usage_example": "(\\d{4})/(\\d{1,2})/(\\d{1,2})",
    "matches": "2026/9/25",
    "replace_with": "\\1-\\2-\\3",
    "replacement_result": "2026-9-25"
  },
  {
    "category": "置換サンプル",
    "label": "CSVの列を並べ替える",
    "pattern": "^([^,]+),([^,]+),([^,]+)$",
    "description": "カンマ以外の文字を3列分取り出し、置換文字で列の順番を変更します。",
    "example_text": "佐藤,太郎,営業",
    "usage_example": "^([^,]+),([^,]+),([^,]+)$",
    "matches": "佐藤,太郎,営業",
    "replace_with": "\\2 \\1（\\3）",
    "replacement_result": "太郎 佐藤（営業）"
  },
  {
    "category": "置換サンプル",
    "label": "全角コロンと半角コロンを統一",
    "pattern": "[：:]",
    "description": "角括弧で候補を並べると、その中のどれか1文字に一致します。表記ゆれの統一に使えます。",
    "example_text": "氏名：佐藤\\n部署:営業",
    "usage_example": "[：:]",
    "matches": "： と :",
    "replace_with": "：",
    "replacement_result": "氏名：佐藤\\n部署：営業"
  },
  {
    "category": "置換サンプル",
    "label": "前後の余分な空白を削る",
    "pattern": "^[ \\t]+|[ \\t]+$",
    "description": "| は または です。行頭の空白、または行末の空白を探して削除します。",
    "example_text": "  メモ  ",
    "usage_example": "^[ \\t]+|[ \\t]+$",
    "matches": "前後のスペース",
    "replace_with": "",
    "replacement_result": "メモ"
  }
]
