<!-- wp:heading -->
<h2 class="wp-block-heading"><span style="color: #0057b8">まずは3級から</span></h2>
<!-- /wp:heading -->

<!-- wp:paragraph -->
<p>日商簿記3級では、</p>
<!-- /wp:paragraph -->

<!-- wp:html -->
<div style="display:inline-block;border:2px solid #985000;padding:16px;margin:2em 0 1.5em;border-radius:8px;font-weight: bold;background-color: #FFF1CF">
・商品の売買、<br><br>
・現金や預金の管理、<br><br>
・帳簿への記録、<br><br>
・決算の基本
</div>
